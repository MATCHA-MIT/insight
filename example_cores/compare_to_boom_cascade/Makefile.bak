#all:
#	verilator --version
#	verilator  -DSTOP_COND=0 -DASSERT_VERBOSE_COND=0 --compiler clang -CFLAGS -std=c++17 --no-stop-fail --x-initial 0 --x-assign 0 -j 0 -Wno-WIDTHEXPAND --no-assert --cc $(VERILATOR_OPTS) -y ../common/testbench -y rtl -y verilog_externalmem_original -f build_config/filelist.f -y sodor_verilog  --top-module correctness --exe verilator_sim/sim_main.cpp --build

   
include build_config/config.cfg

ifndef MEMSIZE
$(error MEMSIZE is not defined. Please define MEMSIZE in the configuration.)
endif

ifndef MAX_SIM_TIME
$(error MAX_SIM_TIME is not defined. Please define MAX_SIM_TIME in the configuration.)
endif

ifndef ADDRESS_WIDTH
$(error define ADDRESS_WIDTH!)
endif

ifndef DUT_CORE_MEM_STRING
$(error define MEM_STRING)
endif 

ifndef START_INDEX_MEMORY
$(error define START_INDEX_MEMORY)
endif  

RTL_files=rtl/*.sv #$(SODOR_FILES)
OTHER_RTL_FILES_BASE= -y ../common/testbench -y rtl -f build_config/filelist.f -Irtl sodor_verilog/*.sv
#PUT CPP DEFINES HERE -- Otherwise verilator will nto pass them correctly to the cpp testbench!
#-DCASCADE=1
DEFINES=-DBOOM=1 -DPROVIDE_EXTERNAL_INIT=1 -DCASCADE=1 -DDEBUG=1 -DMEMSIZE=$(MEMSIZE) -DMAX_SIM_TIME=$(MAX_SIM_TIME) -DADDRESS_WIDTH=$(ADDRESS_WIDTH) -DDUT_CORE_MEM_STRING=$(DUT_CORE_MEM_STRING) -DSTART_INDEX_MEMORY=$(START_INDEX_MEMORY) -DVL_USER_FINISH=1 
VERILATOR_OPTS=-cc -CFLAGS "$(DEFINES) -DVL_USER_FINISH=1 -fPIC -std=c++17" +define+MEMSIZE=$(MEMSIZE) -DPRINTF_COND=0 -DSTOP_COND=0 -DASSERT_VERBOSE_COND=0 --no-assert --x-initial 0 --compiler clang --trace-fst --trace-max-array 2048 --trace-structs -j 0  --x-assign 0 --trace-structs --trace-underscore --trace  --build -j 0 --no-assert --no-stop-fail 
DISABLED_WARNING=-Wno-PINMISSING -Wno-LATCH -Wno-WIDTHEXPAND -Wno-TIMESCALEMOD -Wno-UNOPTFLAT -Wno-WIDTHTRUNC
#efine+SYNTHESIS=1 
#-Wno-Widthexpand
#--Wno-PINMISSING
VERILATOR_OPTS += $(DISABLED_WARNING)



# Add -trace-conditions only if USE_STANDARD_VERILATOR is NOT set
ifeq ($(USE_STANDARD_VERILATOR),)
VERILATOR_OPTS += -trace-conditions
endif

ifeq ($(USE_STANDARD_VERILATOR),)
VERILATOR_PATH=$(realpath ../../../tools/verilator/bin/verilator)
VERILATOR_ALREADY_BUILT=$(wildcard ../../../tools/verilator/build_done)
ifeq ($(VERILATOR_ALREADY_BUILT),)
$(error Verilator not built. Please run cd ../../../tools/verilator/ && ./build.sh)
endif
else
VERILATOR_PATH=verilator
endif

.EXPORT_ALL_VARIABLES:

CXX = g++
CC = gcc

# Build configurations: DIR, VERILOG_SRC, LIB_NAME
BUILD_NORMAL_DIR = obj_dir
BUILD_NORMAL_VERILOG = verilog_externalmem_original
BUILD_NORMAL_LIB = libcorrectness.so

BUILD_REFERENCE_DIR = obj_dir_reference
BUILD_REFERENCE_VERILOG = verilog_bug_free_boom
BUILD_REFERENCE_LIB = libcorrectness_reference.so

BUILD_NO_B4_DIR = obj_dir_no_b4
BUILD_NO_B4_VERILOG = verilog_boom_no_b4_bug
BUILD_NO_B4_LIB = libcorrectness_no_b4.so

# List all build targets
BUILD_TARGETS = $(BUILD_NORMAL_DIR)/$(BUILD_NORMAL_LIB) $(BUILD_REFERENCE_DIR)/$(BUILD_REFERENCE_LIB) $(BUILD_NO_B4_DIR)/$(BUILD_NO_B4_LIB)

all: $(BUILD_TARGETS)

# Function to get verilog source for a directory
get_verilog = $(if $(filter $(BUILD_NORMAL_DIR),$1),$(BUILD_NORMAL_VERILOG),$(if $(filter $(BUILD_REFERENCE_DIR),$1),$(BUILD_REFERENCE_VERILOG),$(BUILD_NO_B4_VERILOG)))

# Helper to generate the full rule set for one configuration
define GEN_RULES_FOR_DIR
# 1 = build dir (e.g., obj_dir)
# 2 = verilog source dir (e.g., verilog_externalmem_original)
# 3 = output shared library name (e.g., libcorrectness.so)

# Ensure build dir exists
$(1):
	@mkdir -p $$@

# Generate external_init.cpp
$(1)/external_init.cpp: generate_external_init.py BOOM.init | $(1)
	python3 generate_external_init.py BOOM.init $$@

# Run Verilator to populate $(1)/Vcorrectness__ALL.a
.PRECIOUS: $(1)/Vcorrectness__ALL.a
$(1)/Vcorrectness__ALL.a: $(1)/external_init.cpp | $(1)
	$(VERILATOR_PATH) $(VERILATOR_OPTS) $(OTHER_RTL_FILES_BASE) \
		-y $(2) \
		correctness.sv \
		--top-module correctness \
		--Mdir $(1) \
		$(1)/external_init.cpp \
		--exe ../common/verilator_sim/sim_main.cpp \
		--build

# Link the shared library
$(1)/$(3): $(1)/Vcorrectness__ALL.a
	$$(CXX) -shared -o $$@ \
	    -Wl,--whole-archive \
	      $(1)/Vcorrectness__ALL.a \
	      $(1)/verilated_threads.o $(1)/verilated_fst_c.o $(1)/verilated.o \
	      $(1)/sim_main.o $(1)/verilated_dpi.o $(1)/external_init.o \
	    -Wl,--no-whole-archive \
	    -fPIC -lstdc++ -lz
	python3 -c 'import ctypes; lib = ctypes.CDLL("$$@", mode=ctypes.RTLD_GLOBAL)'

endef

# Instantiate rules for all three configurations
$(eval $(call GEN_RULES_FOR_DIR,$(BUILD_NORMAL_DIR),$(BUILD_NORMAL_VERILOG),$(BUILD_NORMAL_LIB)))
$(eval $(call GEN_RULES_FOR_DIR,$(BUILD_REFERENCE_DIR),$(BUILD_REFERENCE_VERILOG),$(BUILD_REFERENCE_LIB)))
$(eval $(call GEN_RULES_FOR_DIR,$(BUILD_NO_B4_DIR),$(BUILD_NO_B4_VERILOG),$(BUILD_NO_B4_LIB)))

# Keep your existing 'all' and 'clean' targets
clean:
	rm -rf $(BUILD_NORMAL_DIR) $(BUILD_REFERENCE_DIR) $(BUILD_NO_B4_DIR)

.PHONY: clean all

